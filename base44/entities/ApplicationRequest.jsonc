{
  "name": "ApplicationRequest",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "work_email": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "zip_code": {
      "type": "string"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "under_review",
        "approved",
        "rejected",
        "waitlisted"
      ],
      "default": "submitted"
    },
    "admin_notes": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "ai_recommendation": {
      "type": "string"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "work_email",
    "organization"
  ]
}