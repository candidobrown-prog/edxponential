{
  "name": "SponsoredContent",
  "type": "object",
  "properties": {
    "advertiser_id": {
      "type": "string",
      "description": "Reference to AdvertiserAccount"
    },
    "title": {
      "type": "string",
      "description": "Content title"
    },
    "description": {
      "type": "string",
      "description": "Content description/excerpt"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "article",
        "tool",
        "event",
        "webinar",
        "course",
        "resource",
        "product",
        "job_listing",
        "whitepaper"
      ],
      "description": "Type of sponsored content"
    },
    "category": {
      "type": "string",
      "enum": [
        "leadership",
        "operations",
        "academic",
        "technology",
        "finance",
        "policy",
        "innovation",
        "community"
      ],
      "description": "Content category"
    },
    "featured_image_url": {
      "type": "string",
      "description": "Featured image for content"
    },
    "logo_url": {
      "type": "string",
      "description": "Sponsor logo"
    },
    "sponsor_name": {
      "type": "string",
      "description": "Sponsor name/brand"
    },
    "label": {
      "type": "string",
      "enum": [
        "Sponsored",
        "Partner Content",
        "Recommended Partner",
        "Featured Resource"
      ],
      "default": "Sponsored",
      "description": "Disclosure label"
    },
    "cta_url": {
      "type": "string",
      "description": "Click destination"
    },
    "cta_text": {
      "type": "string",
      "default": "Learn More",
      "description": "CTA button text"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "published",
        "archived"
      ],
      "default": "draft",
      "description": "Publication status"
    },
    "publish_date": {
      "type": "string",
      "format": "date",
      "description": "When content goes live"
    },
    "placement_priority": {
      "type": "number",
      "description": "Priority for featured placements (1-10)"
    },
    "target_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Target user roles"
    },
    "impressions": {
      "type": "number",
      "default": 0,
      "description": "Number of times shown"
    },
    "clicks": {
      "type": "number",
      "default": 0,
      "description": "Number of clicks"
    },
    "conversions": {
      "type": "number",
      "default": 0,
      "description": "Number of conversions"
    },
    "created_by": {
      "type": "string",
      "description": "Email of creator"
    },
    "approved_by": {
      "type": "string",
      "description": "Email of approver"
    }
  },
  "required": [
    "advertiser_id",
    "title",
    "content_type",
    "sponsor_name"
  ]
}