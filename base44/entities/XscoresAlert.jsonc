{
  "name": "XscoresAlert",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "teacher": {
      "type": "string"
    },
    "benchmark_id": {
      "type": "string"
    },
    "benchmark_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "trigger_description": {
      "type": "string"
    },
    "current_value": {
      "type": "number"
    },
    "threshold_value": {
      "type": "number"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "watch",
        "concern",
        "at_risk",
        "critical"
      ],
      "default": "concern"
    },
    "recommended_action": {
      "type": "string"
    },
    "assigned_to": {
      "type": "string"
    },
    "reviewed": {
      "type": "boolean",
      "default": false
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "follow_up_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "escalated"
      ],
      "default": "open"
    }
  },
  "required": [
    "student_id",
    "student_name",
    "benchmark_name",
    "risk_level"
  ]
}