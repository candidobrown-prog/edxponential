{
  "name": "OpxPayroll",
  "type": "object",
  "properties": {
    "pay_period_start": {
      "type": "string",
      "format": "date"
    },
    "pay_period_end": {
      "type": "string",
      "format": "date"
    },
    "pay_date": {
      "type": "string",
      "format": "date"
    },
    "employee_id": {
      "type": "string"
    },
    "employee_name": {
      "type": "string"
    },
    "gross_pay": {
      "type": "number"
    },
    "federal_tax": {
      "type": "number"
    },
    "state_tax": {
      "type": "number"
    },
    "social_security": {
      "type": "number"
    },
    "medicare": {
      "type": "number"
    },
    "benefits_deduction": {
      "type": "number",
      "default": 0
    },
    "other_deductions": {
      "type": "number",
      "default": 0
    },
    "net_pay": {
      "type": "number"
    },
    "hours_worked": {
      "type": "number"
    },
    "overtime_hours": {
      "type": "number",
      "default": 0
    },
    "bonus": {
      "type": "number",
      "default": 0
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "direct_deposit",
        "check",
        "manual"
      ],
      "default": "direct_deposit"
    },
    "approved_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "processed",
        "failed"
      ],
      "default": "draft"
    }
  },
  "required": [
    "employee_id",
    "employee_name",
    "pay_period_start",
    "pay_period_end",
    "gross_pay"
  ]
}