{
  "name": "Advertisement",
  "type": "object",
  "properties": {
    "campaign_id": {
      "type": "string",
      "description": "Reference to AdvertiserCampaign"
    },
    "advertiser_id": {
      "type": "string",
      "description": "Reference to AdvertiserAccount"
    },
    "title": {
      "type": "string",
      "description": "Ad headline/title"
    },
    "description": {
      "type": "string",
      "description": "Ad description"
    },
    "body_text": {
      "type": "string",
      "description": "Longer ad copy"
    },
    "image_url": {
      "type": "string",
      "description": "Ad image/creative URL"
    },
    "logo_url": {
      "type": "string",
      "description": "Advertiser logo"
    },
    "cta_text": {
      "type": "string",
      "enum": [
        "Learn More",
        "Discover",
        "Explore",
        "Get Started",
        "Try Free",
        "View Details",
        "Visit",
        "Sign Up"
      ],
      "default": "Learn More",
      "description": "Call-to-action button text"
    },
    "cta_url": {
      "type": "string",
      "description": "Click destination URL"
    },
    "ad_type": {
      "type": "string",
      "enum": [
        "banner",
        "card",
        "sidebar",
        "sponsored_content",
        "video",
        "native"
      ],
      "default": "card",
      "description": "Ad format type"
    },
    "placement_type": {
      "type": "string",
      "enum": [
        "dashboard_panel",
        "feed",
        "sidebar",
        "between_sections",
        "footer",
        "empty_state",
        "recommended",
        "newsletter",
        "search_results"
      ],
      "description": "Where ad appears"
    },
    "target_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Target user roles (founder, principal, teacher, tutor, coach, investor, etc.)"
    },
    "target_interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Target user interests/categories"
    },
    "target_organization_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Target school types, districts, nonprofits, etc."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "active",
        "paused",
        "archived",
        "rejected"
      ],
      "default": "draft",
      "description": "Ad status"
    },
    "budget_daily": {
      "type": "number",
      "description": "Daily budget in dollars"
    },
    "budget_total": {
      "type": "number",
      "description": "Total campaign budget in dollars"
    },
    "spend_to_date": {
      "type": "number",
      "default": 0,
      "description": "Amount spent so far"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Campaign start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Campaign end date"
    },
    "pricing_model": {
      "type": "string",
      "enum": [
        "cpc",
        "cpm",
        "cpa",
        "flat_rate"
      ],
      "default": "cpc",
      "description": "Pricing model"
    },
    "price_per_unit": {
      "type": "number",
      "description": "Cost per click/impression/action"
    },
    "impressions": {
      "type": "number",
      "default": 0,
      "description": "Total impressions"
    },
    "clicks": {
      "type": "number",
      "default": 0,
      "description": "Total clicks"
    },
    "conversions": {
      "type": "number",
      "default": 0,
      "description": "Total conversions"
    },
    "ctr": {
      "type": "number",
      "description": "Click-through rate percentage"
    },
    "conversion_rate": {
      "type": "number",
      "description": "Conversion rate percentage"
    },
    "quality_score": {
      "type": "number",
      "description": "Platform quality score (1-10)"
    },
    "is_internal_promo": {
      "type": "boolean",
      "default": false,
      "description": "Is this an internal platform promotion?"
    },
    "is_sponsored_content": {
      "type": "boolean",
      "default": false,
      "description": "Is this sponsored/native content?"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Is this a featured/premium placement?"
    },
    "notes": {
      "type": "string",
      "description": "Admin notes"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason for rejection if applicable"
    },
    "created_by": {
      "type": "string",
      "description": "Email of advertiser who created it"
    },
    "approved_by": {
      "type": "string",
      "description": "Email of admin who approved it"
    }
  },
  "required": [
    "campaign_id",
    "advertiser_id",
    "title",
    "cta_url",
    "placement_type"
  ]
}