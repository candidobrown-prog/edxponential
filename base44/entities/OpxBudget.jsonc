{
  "name": "OpxBudget",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "fiscal_year": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "instruction",
        "administration",
        "operations",
        "facilities",
        "technology",
        "student_services",
        "grants",
        "special_programs",
        "transportation",
        "food_service",
        "other"
      ]
    },
    "budget_type": {
      "type": "string",
      "enum": [
        "operating",
        "capital",
        "grant",
        "reserve",
        "restricted"
      ],
      "default": "operating"
    },
    "allocated_amount": {
      "type": "number"
    },
    "spent_amount": {
      "type": "number",
      "default": 0
    },
    "committed_amount": {
      "type": "number",
      "default": 0
    },
    "remaining_amount": {
      "type": "number"
    },
    "q1_budget": {
      "type": "number"
    },
    "q2_budget": {
      "type": "number"
    },
    "q3_budget": {
      "type": "number"
    },
    "q4_budget": {
      "type": "number"
    },
    "q1_actual": {
      "type": "number"
    },
    "q2_actual": {
      "type": "number"
    },
    "q3_actual": {
      "type": "number"
    },
    "q4_actual": {
      "type": "number"
    },
    "variance_pct": {
      "type": "number"
    },
    "grant_source": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "overspent",
        "closed"
      ],
      "default": "draft"
    }
  },
  "required": [
    "name",
    "fiscal_year",
    "category",
    "allocated_amount"
  ]
}