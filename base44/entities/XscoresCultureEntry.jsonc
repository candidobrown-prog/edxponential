{
  "name": "XscoresCultureEntry",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "homeroom": {
      "type": "string"
    },
    "teacher": {
      "type": "string"
    },
    "submitted_by_email": {
      "type": "string"
    },
    "entry_date": {
      "type": "string",
      "format": "date"
    },
    "entry_time": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "attendance",
        "tardy",
        "early_dismissal",
        "absence_excused",
        "absence_unexcused",
        "uniform_violation",
        "infraction_minor",
        "infraction_major",
        "suspension",
        "expulsion",
        "office_referral",
        "counselor_referral",
        "bullying",
        "safety_incident",
        "classroom_disruption",
        "non_compliance",
        "parent_contact",
        "teacher_call",
        "positive_recognition"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low"
    },
    "description": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "action_taken": {
      "type": "string"
    },
    "parent_contacted": {
      "type": "boolean",
      "default": false
    },
    "follow_up_required": {
      "type": "boolean",
      "default": false
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "open",
        "pending",
        "resolved"
      ],
      "default": "open"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "student_name",
    "category",
    "entry_date"
  ]
}