{
  "name": "DealRoom",
  "type": "object",
  "properties": {
    "founder_email": {
      "type": "string"
    },
    "founder_name": {
      "type": "string"
    },
    "founder_photo": {
      "type": "string"
    },
    "founder_background": {
      "type": "string"
    },
    "founder_track_record": {
      "type": "string"
    },
    "years_operating": {
      "type": "number"
    },
    "organization": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "thesis": {
      "type": "string",
      "description": "One-line investment thesis"
    },
    "opportunity_thesis": {
      "type": "string",
      "description": "AI-generated founder opportunity thesis"
    },
    "problem": {
      "type": "string"
    },
    "solution": {
      "type": "string"
    },
    "vision": {
      "type": "string"
    },
    "growth_plan": {
      "type": "string"
    },
    "evidence_of_traction": {
      "type": "string"
    },
    "risks": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "idea",
        "launch",
        "early_traction",
        "growth",
        "turnaround",
        "acquisition"
      ]
    },
    "education_type": {
      "type": "string",
      "enum": [
        "charter",
        "private",
        "public",
        "higher_ed",
        "edtech",
        "services",
        "other"
      ]
    },
    "capital_type_requested": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "donation",
          "grant",
          "equity",
          "revenue_share",
          "loan",
          "philanthropic",
          "strategic_partnership"
        ]
      }
    },
    "impact_focus": {
      "type": "string",
      "enum": [
        "literacy",
        "math",
        "culture",
        "scaling",
        "turnaround",
        "access"
      ]
    },
    "desired_investor_involvement": {
      "type": "string",
      "enum": [
        "passive_capital",
        "advisory",
        "board",
        "strategic_partner",
        "hands_on"
      ]
    },
    "risk_profile": {
      "type": "string",
      "enum": [
        "conservative",
        "balanced",
        "bold",
        "transformational"
      ]
    },
    "amount_seeking": {
      "type": "number"
    },
    "minimum_investment": {
      "type": "number"
    },
    "committed_capital": {
      "type": "number",
      "default": 0
    },
    "use_of_funds": {
      "type": "string"
    },
    "timeline": {
      "type": "string"
    },
    "geography": {
      "type": "string"
    },
    "current_revenue": {
      "type": "number"
    },
    "reading_proficiency": {
      "type": "number"
    },
    "math_proficiency": {
      "type": "number"
    },
    "attendance_rate": {
      "type": "number"
    },
    "enrollment": {
      "type": "number"
    },
    "teacher_retention": {
      "type": "number"
    },
    "reading_growth": {
      "type": "number"
    },
    "math_growth": {
      "type": "number"
    },
    "pitch_deck_url": {
      "type": "string"
    },
    "financials_url": {
      "type": "string"
    },
    "growth_plan_url": {
      "type": "string"
    },
    "data_report_url": {
      "type": "string"
    },
    "board_deck_url": {
      "type": "string"
    },
    "legal_docs_url": {
      "type": "string"
    },
    "pitch_readiness_score": {
      "type": "number",
      "default": 0
    },
    "pitch_readiness_label": {
      "type": "string"
    },
    "ai_suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_review",
        "active",
        "closed",
        "funded"
      ],
      "default": "draft"
    },
    "saves_count": {
      "type": "number",
      "default": 0
    },
    "intros_count": {
      "type": "number",
      "default": 0
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "admin_notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "founder_name",
    "description",
    "stage"
  ]
}