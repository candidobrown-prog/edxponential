{
  "name": "Xschetails",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "school_type": {
      "type": "string",
      "enum": [
        "charter",
        "traditional_public",
        "private",
        "private_religious",
        "magnet",
        "virtual",
        "higher_ed",
        "other"
      ]
    },
    "grades_served": {
      "type": "string"
    },
    "enrollment": {
      "type": "number"
    },
    "location": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "year_founded": {
      "type": "number"
    },
    "authorizer_district": {
      "type": "string"
    },
    "leadership_team": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "pct_economically_disadvantaged": {
      "type": "number"
    },
    "pct_iep": {
      "type": "number"
    },
    "pct_multilingual": {
      "type": "number"
    },
    "family_engagement_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "community_partnerships": {
      "type": "string"
    },
    "neighborhood_context": {
      "type": "string"
    },
    "community_strengths": {
      "type": "string"
    },
    "community_challenges": {
      "type": "string"
    },
    "reading_proficiency": {
      "type": "number"
    },
    "math_proficiency": {
      "type": "number"
    },
    "science_proficiency": {
      "type": "number"
    },
    "student_growth_data": {
      "type": "string"
    },
    "assessment_platforms": {
      "type": "string"
    },
    "curriculum_used": {
      "type": "string"
    },
    "intervention_systems": {
      "type": "string"
    },
    "priority_academic_gaps": {
      "type": "string"
    },
    "attendance_rate": {
      "type": "number"
    },
    "chronic_absenteeism_pct": {
      "type": "number"
    },
    "suspension_rate": {
      "type": "number"
    },
    "student_culture_rating": {
      "type": "number"
    },
    "staff_culture_rating": {
      "type": "number"
    },
    "family_satisfaction_rating": {
      "type": "number"
    },
    "safety_concerns": {
      "type": "string"
    },
    "classroom_management_needs": {
      "type": "string"
    },
    "num_teachers": {
      "type": "number"
    },
    "teacher_retention_pct": {
      "type": "number"
    },
    "vacancies": {
      "type": "string"
    },
    "hard_to_fill_roles": {
      "type": "string"
    },
    "leadership_vacancies": {
      "type": "string"
    },
    "coaching_needs": {
      "type": "string"
    },
    "pd_needs": {
      "type": "string"
    },
    "budget_size": {
      "type": "number"
    },
    "enrollment_trend": {
      "type": "string",
      "enum": [
        "growing",
        "stable",
        "declining"
      ]
    },
    "facilities_needs": {
      "type": "string"
    },
    "technology_needs": {
      "type": "string"
    },
    "compliance_needs": {
      "type": "string"
    },
    "data_systems_used": {
      "type": "string"
    },
    "operations_pain_points": {
      "type": "string"
    },
    "top_goals": {
      "type": "string"
    },
    "biggest_challenge": {
      "type": "string"
    },
    "urgency_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ]
    },
    "desired_outcomes": {
      "type": "string"
    },
    "improvement_timeline": {
      "type": "string"
    },
    "support_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "funding_requested": {
      "type": "boolean",
      "default": false
    },
    "capital_amount_needed": {
      "type": "number"
    },
    "use_of_funds": {
      "type": "string"
    },
    "funding_timeline": {
      "type": "string"
    },
    "pitch_deck_url": {
      "type": "string"
    },
    "financials_url": {
      "type": "string"
    },
    "strategic_plan_url": {
      "type": "string"
    },
    "school_improvement_plan_url": {
      "type": "string"
    },
    "staffing_plan_url": {
      "type": "string"
    },
    "curriculum_plan_url": {
      "type": "string"
    },
    "ai_summary": {
      "type": "string"
    },
    "ai_strengths": {
      "type": "string"
    },
    "ai_risks": {
      "type": "string"
    },
    "ai_recommendations": {
      "type": "string"
    },
    "ai_90_day_plan": {
      "type": "string"
    },
    "pitch_readiness_score": {
      "type": "number",
      "default": 0
    },
    "completion_pct": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "complete",
        "ai_analyzed"
      ],
      "default": "draft"
    }
  },
  "required": [
    "school_name",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}