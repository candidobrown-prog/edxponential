{
  "name": "EdVisorReview",
  "type": "object",
  "properties": {
    "edvisor_id": {
      "type": "string",
      "description": "ID of the CoachingSession (edVisor)"
    },
    "reviewer_name": {
      "type": "string"
    },
    "reviewer_email": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "description": "1-5 star rating"
    },
    "review_text": {
      "type": "string"
    },
    "session_type": {
      "type": "string"
    }
  },
  "required": [
    "edvisor_id",
    "rating"
  ],
  "rls": {
    "create": {
      "data.reviewer_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.reviewer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.reviewer_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}