{
  "name": "AdAnalytics",
  "type": "object",
  "properties": {
    "ad_id": {
      "type": "string",
      "description": "Reference to Advertisement"
    },
    "campaign_id": {
      "type": "string",
      "description": "Reference to AdvertiserCampaign"
    },
    "advertiser_id": {
      "type": "string",
      "description": "Reference to AdvertiserAccount"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Analytics date"
    },
    "impressions": {
      "type": "number",
      "default": 0,
      "description": "Number of impressions on this date"
    },
    "clicks": {
      "type": "number",
      "default": 0,
      "description": "Number of clicks on this date"
    },
    "conversions": {
      "type": "number",
      "default": 0,
      "description": "Number of conversions on this date"
    },
    "spend": {
      "type": "number",
      "default": 0,
      "description": "Spend on this date"
    },
    "ctr": {
      "type": "number",
      "description": "Click-through rate percentage"
    },
    "conversion_rate": {
      "type": "number",
      "description": "Conversion rate percentage"
    },
    "cpc": {
      "type": "number",
      "description": "Cost per click"
    },
    "cpa": {
      "type": "number",
      "description": "Cost per acquisition"
    },
    "roas": {
      "type": "number",
      "description": "Return on ad spend"
    },
    "dismissed": {
      "type": "number",
      "default": 0,
      "description": "Number of ads dismissed"
    },
    "engagement_rate": {
      "type": "number",
      "description": "Engagement rate percentage"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "When analytics were recorded"
    }
  },
  "required": [
    "ad_id",
    "campaign_id",
    "advertiser_id",
    "date"
  ]
}