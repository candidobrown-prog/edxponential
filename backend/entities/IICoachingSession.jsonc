// Instructional Intelligence entity — accessed only through /api/ii (authorization in backend/src/ii/authz.js)
{
  "name": "IICoachingSession",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "observation_id": {
      "type": "string"
    },
    "coach_email": {
      "type": "string"
    },
    "teacher_email": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "priorities": {
      "type": "array",
      "default": []
    },
    "commitments": {
      "type": "array",
      "default": []
    },
    "support_needed": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string"
    },
    "acknowledgments": {
      "type": "object",
      "default": {}
    },
    "disagreement_note": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "draft"
    },
    "scheduled_at": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "school_id",
    "coach_email",
    "teacher_email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__ii_internal_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__ii_internal_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__ii_internal_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__ii_internal_only__"
      }
    }
  }
}
