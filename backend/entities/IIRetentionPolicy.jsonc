// Instructional Intelligence entity — accessed only through /api/ii (authorization in backend/src/ii/authz.js)
{
  "name": "IIRetentionPolicy",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "media_days": {
      "type": "number",
      "default": 365
    },
    "transcript_days": {
      "type": "number",
      "default": 1095
    },
    "policy_text": {
      "type": "string"
    },
    "set_by": {
      "type": "string"
    }
  },
  "required": [
    "organization_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__ii_internal_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__ii_internal_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__ii_internal_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__ii_internal_only__"
      }
    }
  }
}
