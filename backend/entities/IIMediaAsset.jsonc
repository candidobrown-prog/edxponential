// Instructional Intelligence entity — accessed only through /api/ii (authorization in backend/src/ii/authz.js)
{
  "name": "IIMediaAsset",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "observation_id": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "mime": {
      "type": "string"
    },
    "storage": {
      "type": "string"
    },
    "chunks": {
      "type": "array",
      "default": []
    },
    "finalized": {
      "type": "boolean",
      "default": false
    },
    "duration_seconds": {
      "type": "number"
    },
    "size_bytes": {
      "type": "number",
      "default": 0
    },
    "sha256": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "uploading"
    },
    "uploaded_by": {
      "type": "string"
    },
    "original_filename": {
      "type": "string"
    },
    "deleted_at": {
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "school_id",
    "observation_id",
    "kind",
    "uploaded_by"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__ii_internal_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__ii_internal_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__ii_internal_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__ii_internal_only__"
      }
    }
  }
}
