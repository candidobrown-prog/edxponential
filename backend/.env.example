# ---- Core ----
PORT=8787
# Public URL of the app (used for upload links and Stripe redirects)
PUBLIC_URL=http://localhost:8787
# Database. Leave empty for local dev (an embedded Postgres is stored in DATA_DIR).
# On Vercel the Supabase integration sets POSTGRES_URL automatically — you don't set this by hand.
DATABASE_URL=
# Optional: long random string for signing logins (defaults to a value derived from DATABASE_URL)
JWT_SECRET=
# Local data folder (embedded database + uploads)
DATA_DIR=./data
# Optional: keep tables in their own schema when sharing a database (e.g. edx)
DB_SCHEMA=
# File uploads: Vercel Blob (BLOB_READ_WRITE_TOKEN, set by the Vercel Blob store) or Supabase Storage (these two):
BLOB_READ_WRITE_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Protects /api/cron/reminders (Vercel Cron sends it automatically when set in Vercel)
CRON_SECRET=
# Comma-separated emails that are always admins (the first account created is also made admin)
ADMIN_EMAILS=
# Set to "false" to stop anyone from self-registering (admins can still create users)
ALLOW_SIGNUP=true

# ---- AI (replaces Base44 InvokeLLM) ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# ---- Email (replaces Base44 SendEmail). If SMTP_URL is empty, emails are only logged ----
SMTP_URL=
EMAIL_FROM="edXponential <no-reply@example.com>"

# ---- Payments ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- GitHub PR dashboard (replaces Base44 GitHub connector) ----
GITHUB_TOKEN=

# ---- Scheduled jobs ----
# Cron for the session-reminder email job (default: every day at 14:00 server time)
REMINDER_CRON=0 14 * * *
